---
const {
	title = 'FORMA — Thoughtful Home & Lifestyle',
	description = 'Thoughtful home and lifestyle essentials, made to bring a little more meaning to the everyday.',
	socialImage = 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85',
	socialImageAlt = title,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f7f5f0" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={socialImageAlt} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=DM+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	const motionTargets = [
		'main > section',
		'main > nav.breadcrumbs',
		'main .hero-copy > *',
		'main .hero-visual',
		'main .category-card',
		'main .product-card',
		'main .story-image',
		'main .story-copy > *',
		'main .promise-item',
		'main .shop-intro > *',
		'main .catalog-heading',
		'main .catalog-tools',
		'main .about-hero > *',
		'main .values-grid article',
		'main .product-detail > *',
		'main .related-heading',
		'main .checkout-heading > *',
		'main .checkout-layout > *',
		'main .success-card > *',
	].join(',');

	if (
		'IntersectionObserver' in window &&
		!window.matchMedia('(prefers-reduced-motion: reduce)').matches
	) {
		const observer = new IntersectionObserver(
			(entries, currentObserver) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					currentObserver.unobserve(entry.target);
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
		);

		document.querySelectorAll(motionTargets).forEach((element, index) => {
			element.classList.add('motion-reveal');
			element.style.setProperty('--motion-delay', `${(index % 4) * 70}ms`);
			observer.observe(element);
		});
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 20px;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	:global(body) {
		-webkit-font-smoothing: antialiased;
	}

	:global(::selection) {
		background: #d9dccb;
		color: #272722;
	}

	:global(.motion-reveal) {
		opacity: 0;
		transform: translate3d(0, 26px, 0) scale(.99);
		transition:
			opacity .8s cubic-bezier(.2, .7, .2, 1),
			transform .8s cubic-bezier(.2, .7, .2, 1);
		transition-delay: var(--motion-delay, 0ms);
	}

	:global(.motion-reveal.is-visible) {
		opacity: 1;
		transform: translate3d(0, 0, 0) scale(1);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}

		:global(*),
		:global(*::before),
		:global(*::after) {
			animation-duration: .01ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: .01ms !important;
		}
	}
</style>
