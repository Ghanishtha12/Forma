---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Our Story — FORMA"
	description="Meet FORMA: a modern home and lifestyle brand creating thoughtful pieces with independent makers and responsible workshops."
>
	<Header />
	<main>
		<section class="about-hero">
			<p class="eyebrow">A little about us</p>
			<h1>Make room for<br />what <em>matters.</em></h1>
			<p>We believe the things we live with can make everyday life feel a little more considered.</p>
		</section>
		<section class="story-section">
			<div class="story-image">
				<img
					src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1400&q=85"
					alt="A warm, sunlit living room with natural materials and simple details"
					loading="lazy"
				/>
				<span>A home is never finished. It grows with you.</span>
			</div>
			<div class="story-copy">
				<p class="eyebrow">Why FORMA exists</p>
				<h2>Less, but with<br />more <em>meaning.</em></h2>
				<p>
					FORMA began with a simple thought: the things we live with should make life feel better.
					Not louder, not busier—just a little more considered.
				</p>
				<p>
					We work with independent makers and responsible workshops to create honest, useful pieces
					that feel at home wherever you are. Pieces with a point of view, made to be part of yours.
				</p>
				<p class="signoff">Good things take thought.<span>— The FORMA team</span></p>
			</div>
		</section>
		<section class="values-section" id="promise">
			<div class="values-heading">
				<p class="eyebrow">The FORMA feeling</p>
				<h2>Good by <em>nature.</em></h2>
				<p>Beautiful things should feel good in every way.</p>
			</div>
			<div class="values-grid">
				<article><span>01</span><h3>Thoughtful design</h3><p>Useful, beautiful objects designed with a little more care.</p></article>
				<article><span>02</span><h3>Made to last</h3><p>Good materials, considered details, and quality you can feel.</p></article>
				<article><span>03</span><h3>Mindful choices</h3><p>Working with people and partners who care about how things are made.</p></article>
				<article><span>04</span><h3>Easy by design</h3><p>Thoughtful support and easy returns, whenever you need us.</p></article>
			</div>
			<a class="shop-link" href="/shop">Explore the collection <span aria-hidden="true">↗</span></a>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	:global(body) { background: #f7f5f0; color: #272722; font-family: 'DM Sans', Arial, sans-serif; }
	.about-hero { padding: 79px 8vw 72px; text-align: center; background: #efede7; }
	.eyebrow { margin: 0 0 17px; color: #6d7158; font-size: 9px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; }
	.about-hero h1 { font-size: clamp(54px, 6vw, 79px); line-height: .96; font-weight: 400; letter-spacing: -.05em; margin: 0; }
	.about-hero h1 em, .story-copy h2 em, .values-heading h2 em { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; }
	.about-hero > p:last-child { color: #77766f; font-size: 11px; line-height: 1.8; max-width: 410px; margin: 22px auto 0; }
	.story-section { display: grid; grid-template-columns: 1fr 1fr; min-height: 550px; background: #e5e2d9; }
	.story-image { min-height: 550px; position: relative; overflow: hidden; }
	.story-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.story-image > span { position: absolute; left: 22px; bottom: 18px; color: white; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; font-style: italic; text-shadow: 0 1px 5px #2228; }
	.story-copy { display: flex; flex-direction: column; justify-content: center; padding: 70px clamp(50px, 9vw, 135px); }
	.story-copy .eyebrow { margin-bottom: 20px; }
	.story-copy h2 { font-weight: 400; font-size: clamp(42px, 4vw, 56px); letter-spacing: -.045em; line-height: 1; margin: 0 0 24px; }
	.story-copy > p:not(.eyebrow) { color: #6f6e67; font-size: 11px; line-height: 1.9; margin: 0 0 13px; max-width: 400px; }
	.story-copy .signoff { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px !important; font-style: italic; color: #272722 !important; margin-top: 21px !important; }
	.signoff span { display: block; color: #77766f; font-family: 'DM Sans', Arial, sans-serif; font-size: 9px; font-style: normal; margin-top: 8px; }
	.values-section { padding: 91px 9vw 97px; }
	.values-heading { text-align: center; margin-bottom: 46px; }
	.values-heading .eyebrow { margin-bottom: 13px; }
	.values-heading h2 { font-weight: 400; font-size: clamp(40px, 4vw, 54px); letter-spacing: -.045em; margin: 0; }
	.values-heading > p:last-child { color: #77766f; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px; margin: 12px 0 0; }
	.values-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
	.values-grid article { min-height: 165px; border-left: 1px solid #dfddd5; padding: 0 25px; }
	.values-grid article:first-child { border: 0; padding-left: 0; }
	.values-grid article > span { color: #a3a196; font-size: 9px; }
	.values-grid h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; font-weight: 500; margin: 21px 0 8px; }
	.values-grid p { max-width: 205px; color: #77766f; font-size: 10px; line-height: 1.8; margin: 0; }
	.shop-link { display: flex; width: max-content; margin: 15px auto 0; gap: 15px; color: #272722; text-decoration: none; font-size: 10px; border-bottom: 1px solid #bcbab2; padding-bottom: 7px; transition: gap .2s; }
	.shop-link:hover { gap: 22px; }
	@media(max-width: 980px) {
		.story-copy { padding: 60px 7vw; }
		.values-grid article { padding-inline: 17px; }
	}
	@media(max-width: 680px) {
		.about-hero { padding: 60px 7vw 50px; }
		.about-hero h1 { font-size: clamp(54px, 13vw, 70px); }
		.story-section { grid-template-columns: 1fr; }
		.story-image { min-height: 0; height: 70vw; max-height: 420px; }
		.story-copy { padding: 52px 8vw 55px; }
		.story-copy h2 { font-size: 43px; }
		.values-section { padding: 68px 7vw; }
		.values-heading { margin-bottom: 32px; }
		.values-grid { grid-template-columns: repeat(2, 1fr); row-gap: 28px; }
		.values-grid article { min-height: 150px; padding: 0 12px; }
		.values-grid article:nth-child(odd) { border-left: 0; padding-left: 0; }
		.values-grid article:nth-child(even) { padding-right: 0; }
		.values-grid h3 { font-size: 17px; margin-top: 15px; }
		.values-grid p { font-size: 9px; }
	}
</style>
