---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Checkout — FORMA"
	description="Review your FORMA order and enter delivery details to place a frontend demo order."
>
	<Header />
	<main class="checkout-page">
		<div class="checkout-heading">
			<p class="eyebrow">Almost home</p>
			<h1>A few details, <em>then it’s yours.</em></h1>
			<p>Secure your considered finds. This is a demo checkout; no payment is processed.</p>
		</div>

		<div class="checkout-layout">
			<form class="checkout-form" id="checkout-form" novalidate>
				<section class="form-section" aria-labelledby="contact-heading">
					<div class="form-section-heading">
						<span>01</span>
						<div><h2 id="contact-heading">Your details</h2><p>Where should we reach you?</p></div>
					</div>
					<div class="field-grid">
						<div class="field full-width">
							<label for="full-name">Full name <span>*</span></label>
							<input id="full-name" name="name" autocomplete="name" required aria-describedby="name-error" />
							<p class="field-error" id="name-error"></p>
						</div>
						<div class="field">
							<label for="email">Email address <span>*</span></label>
							<input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-error" />
							<p class="field-error" id="email-error"></p>
						</div>
						<div class="field">
							<label for="phone">Phone number <span>*</span></label>
							<input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="10-digit mobile number" required aria-describedby="phone-error" />
							<p class="field-error" id="phone-error"></p>
						</div>
					</div>
				</section>

				<section class="form-section" aria-labelledby="address-heading">
					<div class="form-section-heading">
						<span>02</span>
						<div><h2 id="address-heading">Delivery address</h2><p>We’ll bring it right to your door.</p></div>
					</div>
					<div class="field-grid">
						<div class="field full-width">
							<label for="address">Street address <span>*</span></label>
							<input id="address" name="address" autocomplete="street-address" required aria-describedby="address-error" />
							<p class="field-error" id="address-error"></p>
						</div>
						<div class="field">
							<label for="city">City <span>*</span></label>
							<input id="city" name="city" autocomplete="address-level2" required aria-describedby="city-error" />
							<p class="field-error" id="city-error"></p>
						</div>
						<div class="field">
							<label for="state">State <span>*</span></label>
							<input id="state" name="state" autocomplete="address-level1" required aria-describedby="state-error" />
							<p class="field-error" id="state-error"></p>
						</div>
						<div class="field">
							<label for="postal-code">PIN code <span>*</span></label>
							<input id="postal-code" name="postalCode" inputmode="numeric" autocomplete="postal-code" maxlength="6" required aria-describedby="postal-error" />
							<p class="field-error" id="postal-error"></p>
						</div>
						<div class="field">
							<label for="country">Country</label>
							<input id="country" name="country" value="India" autocomplete="country-name" readonly />
						</div>
					</div>
				</section>

				<section class="form-section" aria-labelledby="delivery-heading">
					<div class="form-section-heading">
						<span>03</span>
						<div><h2 id="delivery-heading">Delivery method</h2><p>Choose the pace that feels right.</p></div>
					</div>
					<fieldset class="choice-list">
						<legend class="sr-only">Select a delivery method</legend>
						<label class="choice-card selected">
							<input type="radio" name="delivery" value="standard" checked />
							<span class="radio-mark"></span>
							<span class="choice-copy"><strong>Standard Delivery</strong><small>Carefully packed, within 5–7 business days</small></span>
							<strong class="choice-price">Free</strong>
						</label>
						<label class="choice-card">
							<input type="radio" name="delivery" value="express" />
							<span class="radio-mark"></span>
							<span class="choice-copy"><strong>Express Delivery</strong><small>At your door within 2–3 business days</small></span>
							<strong class="choice-price">₹199</strong>
						</label>
					</fieldset>
				</section>

				<section class="form-section payment-section" aria-labelledby="payment-heading">
					<div class="form-section-heading">
						<span>04</span>
						<div><h2 id="payment-heading">Payment method</h2><p>Choose how you’d like to pay.</p></div>
					</div>
					<fieldset class="choice-list payment-list">
						<legend class="sr-only">Select a payment method</legend>
						<label class="choice-card selected">
							<input type="radio" name="payment" value="Cash on Delivery" checked />
							<span class="radio-mark"></span>
							<span class="choice-copy"><strong>Cash on Delivery</strong><small>Pay when your order arrives</small></span>
						</label>
						<label class="choice-card">
							<input type="radio" name="payment" value="UPI" />
							<span class="radio-mark"></span>
							<span class="choice-copy"><strong>UPI</strong><small>Demo option — no payment will be collected</small></span>
						</label>
						<label class="choice-card">
							<input type="radio" name="payment" value="Credit/Debit Card" />
							<span class="radio-mark"></span>
							<span class="choice-copy"><strong>Credit / Debit Card</strong><small>Demo option — no card details requested</small></span>
						</label>
					</fieldset>
					<p class="payment-notice" id="payment-notice" hidden role="status">
						Demo only: choosing UPI or card will not open a payment flow or process a charge.
					</p>
				</section>

				<p class="form-error" id="form-error" role="alert" hidden></p>
				<button class="place-order-button" type="submit" id="place-order" disabled>
					<span>Place demo order</span><span aria-hidden="true">↗</span>
				</button>
				<p class="demo-note">This frontend demo does not process payments or send your details anywhere.</p>
			</form>

			<aside class="order-summary" aria-labelledby="summary-heading">
				<div class="summary-header">
					<div><p class="eyebrow">The good things</p><h2 id="summary-heading">Your order</h2></div>
					<a href="/shop">Keep shopping</a>
				</div>
				<div class="summary-items" id="summary-items" aria-live="polite"></div>
				<div class="empty-cart" id="empty-cart" hidden>
					<p>Your bag is taking a breather.</p>
					<a href="/shop">Explore the collection <span aria-hidden="true">↗</span></a>
				</div>
				<div class="summary-totals" id="summary-totals">
					<p><span>Subtotal</span><strong id="subtotal">₹0</strong></p>
					<p><span>Shipping</span><strong id="shipping">Free</strong></p>
					<div class="summary-total"><span>Total</span><strong id="total">₹0</strong></div>
					<p class="shipping-hint" id="shipping-hint">Free standard delivery selected.</p>
				</div>
			</aside>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	import { products, formatPrice } from '../data/products.js';
	import { getCart, saveCart } from '../data/cart.js';

	const form = document.querySelector('#checkout-form');
	const placeOrder = document.querySelector('#place-order');
	const summaryItems = document.querySelector('#summary-items');
	const emptyCart = document.querySelector('#empty-cart');
	const summaryTotals = document.querySelector('#summary-totals');
	const cart = getCart();
	const cartProducts = cart
		.map((item) => ({ ...products.find((product) => product.id === item.id), quantity: item.quantity }))
		.filter((item) => item.id);

	function renderSummary() {
		summaryItems.replaceChildren();
		cartProducts.forEach((product) => {
			const item = document.createElement('article');
			item.className = 'summary-item';
			const image = document.createElement('img');
			image.src = product.image;
			image.alt = '';
			const details = document.createElement('div');
			details.className = 'summary-item-details';
			const name = document.createElement('h3');
			name.textContent = product.name;
			const category = document.createElement('p');
			category.textContent = `${product.category} · Qty ${product.quantity}`;
			const price = document.createElement('strong');
			price.textContent = formatPrice(product.price * product.quantity);
			details.append(name, category);
			item.append(image, details, price);
			summaryItems.append(item);
		});

		const isEmpty = cartProducts.length === 0;
		emptyCart.hidden = !isEmpty;
		summaryTotals.hidden = isEmpty;
		placeOrder.disabled = isEmpty;
		updateTotals();
	}

	function updateTotals() {
		const subtotal = cartProducts.reduce((sum, product) => sum + product.price * product.quantity, 0);
		const delivery = form.elements.delivery.value === 'express' ? 199 : 0;
		document.querySelector('#subtotal').textContent = formatPrice(subtotal);
		document.querySelector('#shipping').textContent = delivery ? formatPrice(delivery) : 'Free';
		document.querySelector('#total').textContent = formatPrice(subtotal + delivery);
		document.querySelector('#shipping-hint').textContent = delivery
			? 'Express delivery selected.'
			: 'Free standard delivery selected.';
	}

	document.querySelectorAll('input[name="delivery"], input[name="payment"]').forEach((input) => {
		input.addEventListener('change', () => {
			document.querySelectorAll(`input[name="${input.name}"]`).forEach((option) => {
				option.closest('.choice-card').classList.toggle('selected', option.checked);
			});
			if (input.name === 'delivery') updateTotals();
			if (input.name === 'payment') {
				document.querySelector('#payment-notice').hidden =
					input.value === 'Cash on Delivery';
			}
		});
	});

	const validationFields = [
		{ id: 'full-name', error: 'name-error', label: 'Full name', validate: (value) => value.trim().length >= 2 || 'Enter your full name.' },
		{ id: 'email', error: 'email-error', label: 'Email address', validate: (value, input) => input.validity.valid || 'Enter a valid email address.' },
		{ id: 'phone', error: 'phone-error', label: 'Phone number', validate: (value) => /^[6-9]\d{9}$/.test(value.replace(/\D/g, '')) || 'Enter a valid 10-digit Indian mobile number.' },
		{ id: 'address', error: 'address-error', label: 'Street address', validate: (value) => value.trim().length >= 5 || 'Enter your street address.' },
		{ id: 'city', error: 'city-error', label: 'City', validate: (value) => value.trim().length >= 2 || 'Enter your city.' },
		{ id: 'state', error: 'state-error', label: 'State', validate: (value) => value.trim().length >= 2 || 'Enter your state.' },
		{ id: 'postal-code', error: 'postal-error', label: 'PIN code', validate: (value) => /^\d{6}$/.test(value.trim()) || 'Enter a valid 6-digit PIN code.' },
	];

	function validateForm() {
		let firstInvalid;
		validationFields.forEach((field) => {
			const input = document.getElementById(field.id);
			const result = field.validate(input.value, input);
			const error = document.getElementById(field.error);
			const message = result === true ? '' : result;
			error.textContent = message;
			input.setAttribute('aria-invalid', String(Boolean(message)));
			if (message && !firstInvalid) firstInvalid = input;
		});
		if (firstInvalid) {
			firstInvalid.focus();
			return false;
		}
		return true;
	}

	validationFields.forEach(({ id, error }) => {
		document.getElementById(id).addEventListener('input', () => {
			document.getElementById(error).textContent = '';
			document.getElementById(id).setAttribute('aria-invalid', 'false');
			document.querySelector('#form-error').hidden = true;
		});
	});

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		const formError = document.querySelector('#form-error');
		if (!cartProducts.length) {
			formError.textContent = 'Your bag is empty. Add something lovely before placing an order.';
			formError.hidden = false;
			return;
		}
		if (!validateForm()) return;

		const subtotal = cartProducts.reduce((sum, product) => sum + product.price * product.quantity, 0);
		const deliveryMethod = form.elements.delivery.value;
		const shipping = deliveryMethod === 'express' ? 199 : 0;
		const order = {
			number: `FORMA-${Date.now().toString().slice(-8)}`,
			createdAt: new Date().toISOString(),
			customer: {
				name: form.elements.name.value.trim(),
				email: form.elements.email.value.trim(),
				phone: form.elements.phone.value.trim(),
				address: form.elements.address.value.trim(),
				city: form.elements.city.value.trim(),
				state: form.elements.state.value.trim(),
				postalCode: form.elements.postalCode.value.trim(),
				country: form.elements.country.value,
			},
			deliveryMethod,
			paymentMethod: form.elements.payment.value,
			products: cartProducts.map(({ id, name, category, price, image, quantity }) => ({
				id,
				name,
				category,
				price,
				image,
				quantity,
			})),
			subtotal,
			shipping,
			total: subtotal + shipping,
		};

		try {
			sessionStorage.setItem('forma-demo-order', JSON.stringify(order));
			saveCart([]);
		} catch (error) {
			console.error('Unable to save the demo order.', error);
			formError.textContent = 'We could not save this demo order in your browser. Please try again.';
			formError.hidden = false;
			return;
		}
		window.location.assign('/order-success');
	});

	renderSummary();
</script>

<style>
	:global(body) { background: #f7f5f0; color: #272722; font-family: 'DM Sans', Arial, sans-serif; }
	:global(button:focus-visible), :global(input:focus-visible), :global(a:focus-visible) { outline: 2px solid #6d7158; outline-offset: 3px; }
	:global(input[aria-invalid="true"]) { border-color: #9c5548; }
	.checkout-page { padding: 48px 8vw 95px; }
	.checkout-heading { margin: 0 0 42px; }
	.eyebrow { margin: 0 0 12px; color: #6d7158; font-size: 9px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; }
	.checkout-heading h1 { font-size: clamp(38px, 4vw, 52px); font-weight: 400; letter-spacing: -.045em; line-height: 1.05; margin: 0; }
	.checkout-heading h1 em { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; }
	.checkout-heading > p:last-child { color: #77766f; font-size: 10px; margin: 12px 0 0; }
	.checkout-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); align-items: start; gap: clamp(40px, 7vw, 100px); }
	.checkout-form { min-width: 0; }
	.form-section { padding: 0 0 30px; margin: 0 0 28px; border-bottom: 1px solid #dfddd5; }
	.form-section-heading { display: flex; align-items: start; gap: 15px; margin-bottom: 22px; }
	.form-section-heading > span { color: #929087; font-size: 9px; padding-top: 5px; }
	.form-section-heading h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 25px; font-weight: 500; margin: 0 0 4px; }
	.form-section-heading p { color: #88867f; font-size: 9px; margin: 0; }
	.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 14px; }
	.field { min-width: 0; }
	.field.full-width { grid-column: 1 / -1; }
	.field label { display: block; font-size: 9px; margin-bottom: 7px; color: #4e4e47; }
	.field label span { color: #8a6253; }
	.field input { width: 100%; height: 42px; border: 1px solid #dcd9d0; border-radius: 0; background: #fbfaf7; padding: 0 12px; color: #272722; font-size: 10px; }
	.field input::placeholder { color: #a09e95; }
	.field input[readonly] { color: #77766f; background: #efede7; }
	.field-error { min-height: 12px; color: #9c5548; font-size: 8px; margin: 5px 0 0; }
	.choice-list { display: grid; gap: 9px; border: 0; padding: 0; margin: 0; }
	.choice-card { min-width: 0; display: flex; align-items: center; gap: 12px; padding: 13px 14px; border: 1px solid #dfddd5; background: #fbfaf7; cursor: pointer; transition: border-color .2s, background .2s; }
	.choice-card.selected { border-color: #777c61; background: #f0efe8; }
	.choice-card input { position: absolute; opacity: 0; width: 1px; height: 1px; }
	.radio-mark { flex: 0 0 15px; width: 15px; height: 15px; border: 1px solid #9a998f; border-radius: 50%; display: grid; place-items: center; }
	.choice-card input:checked + .radio-mark::after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #6d7158; }
	.choice-card:focus-within { outline: 2px solid #6d7158; outline-offset: 2px; }
	.choice-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4px; }
	.choice-copy strong, .choice-price { font-size: 9px; font-weight: 500; }
	.choice-copy small { color: #85837b; font-size: 8px; line-height: 1.5; }
	.choice-price { white-space: nowrap; }
	.payment-section { margin-bottom: 20px; }
	.payment-notice { padding: 11px 13px; margin: 12px 0 0; background: #e9e7df; color: #646653; font-size: 9px; line-height: 1.6; }
	.payment-notice[hidden] { display: none; }
	.form-error { color: #9c5548; font-size: 9px; margin: 0 0 12px; }
	.form-error[hidden] { display: none; }
	.place-order-button { width: 100%; display: flex; justify-content: space-between; align-items: center; border: 0; padding: 16px 18px; background: #272722; color: #fff; cursor: pointer; font-size: 10px; transition: background .2s, opacity .2s; }
	.place-order-button:hover:not(:disabled) { background: #6d7158; }
	.place-order-button:disabled { cursor: not-allowed; opacity: .48; }
	.demo-note { color: #89877f; font-size: 8px; line-height: 1.6; margin: 10px 0 0; text-align: center; }
	.order-summary { position: sticky; top: 24px; padding: 22px; background: #efede7; }
	.summary-header { display: flex; justify-content: space-between; align-items: end; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid #d9d6cd; }
	.summary-header .eyebrow { font-size: 8px; margin-bottom: 7px; }
	.summary-header h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 27px; font-weight: 400; margin: 0; }
	.summary-header > a { color: #69685f; font-size: 8px; text-decoration: none; border-bottom: 1px solid #bcbab2; padding-bottom: 4px; }
	:global(.summary-item) { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; align-items: center; gap: 11px; padding: 14px 0; border-bottom: 1px solid #d9d6cd; }
	:global(.summary-item img) { display: block; width: 58px; height: 64px; object-fit: cover; background: #e2dfd8; }
	:global(.summary-item-details) { min-width: 0; }
	:global(.summary-item h3) { font-size: 9px; font-weight: 500; line-height: 1.5; margin: 0 0 4px; }
	:global(.summary-item p) { color: #85837b; font-size: 8px; margin: 0; }
	:global(.summary-item > strong) { white-space: nowrap; font-size: 9px; font-weight: 500; }
	.summary-totals { padding-top: 15px; }
	.summary-totals > p:not(.shipping-hint) { display: flex; justify-content: space-between; color: #6f6e67; font-size: 9px; margin: 0 0 12px; }
	.summary-totals > p strong { color: #272722; font-weight: 500; }
	.summary-total { display: flex; justify-content: space-between; border-top: 1px solid #d9d6cd; padding-top: 14px; margin-top: 16px; font-size: 11px; }
	.summary-total strong { font-weight: 500; }
	.shipping-hint { color: #85837b; font-size: 8px; margin: 8px 0 0; text-align: right; }
	.empty-cart { padding: 25px 0 7px; }
	.empty-cart p { color: #6f6e67; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; margin: 0 0 12px; }
	.empty-cart a { color: #272722; font-size: 9px; text-decoration: none; border-bottom: 1px solid #bcbab2; padding-bottom: 5px; }
	.empty-cart[hidden], .summary-totals[hidden] { display: none; }
	@media(max-width: 860px) {
		.checkout-page { padding-inline: 6vw; }
		.checkout-layout { grid-template-columns: minmax(0, 1fr) minmax(270px, .8fr); gap: 28px; }
		.order-summary { padding: 18px; }
	}
	@media(max-width: 680px) {
		.checkout-page { padding: 38px 6vw 65px; }
		.checkout-heading { margin-bottom: 30px; }
		.checkout-heading h1 { font-size: 38px; }
		.checkout-layout { grid-template-columns: 1fr; gap: 28px; }
		.order-summary { position: static; grid-row: 1; padding: 18px; }
		.checkout-form { grid-row: 2; }
		.form-section { padding-bottom: 24px; margin-bottom: 23px; }
		.field-grid { gap: 12px 10px; }
		.field input { padding-inline: 10px; }
	}
</style>
