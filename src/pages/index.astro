---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, formatPrice } from '../data/products.js';

const categories = [
	{
		name: 'Furniture',
		image:
			'https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1000&q=85',
		description: 'Pieces to live with',
	},
	{
		name: 'Home Decor',
		image:
			'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=85',
		description: 'Details that make a home',
	},
	{
		name: 'Lighting',
		image:
			'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=1000&q=85',
		description: 'A softer kind of glow',
	},
	{
		name: 'Everyday Essentials',
		image:
			'https://images.unsplash.com/photo-1603006905003-be475563bc59?auto=format&fit=crop&w=1000&q=85',
		description: 'The little things, considered',
	},
];

---

<Layout
	title="FORMA — Make Space for Better Living"
	description="Thoughtful home and lifestyle essentials, made to bring a little more meaning to the everyday."
>
	<Header />
	<main>
		<section class="hero" id="home" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span></span> Considered living, naturally</p>
				<h1 id="hero-title">Make space for<br />better <em>living.</em></h1>
				<p class="hero-description">
					Thoughtful things for the spaces we call home. Made to be lived with, and loved for a long
					time.
				</p>
				<a class="button button-dark" href="/shop">
					Shop the collection
					<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 10h12m-5-5 5 5-5 5" /></svg>
				</a>
				<div class="hero-note">
					<span class="note-rule"></span>
					<span>Objects for slower, more intentional days.</span>
				</div>
			</div>
			<div class="hero-visual">
				<img
					src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=90"
					alt="Sunlit living room with sculptural furniture and natural textures"
					fetchpriority="high"
				/>
				<div class="hero-image-label">
					<span>01 / 04</span>
					<span>Quiet moments, at home</span>
				</div>
				<div class="hero-stamp" aria-hidden="true">
					<span>MADE FOR</span>
					<strong>the everyday</strong>
					<span>EST. WITH INTENTION</span>
				</div>
			</div>
		</section>

		<section class="trust-strip" aria-label="Our promise">
			<p>Made for living</p><span></span>
			<p>Designed to last</p><span></span>
			<p>Thoughtfully sourced</p><span></span>
			<p>Rooted in India</p>
		</section>

		<section class="section categories-section" id="collections">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Find your feeling</p>
					<h2>Spaces, made <em>yours.</em></h2>
				</div>
				<a class="text-link" href="/shop">Explore all pieces <span aria-hidden="true">↗</span></a>
			</div>
			<div class="category-grid">
				{categories.map((category) => (
						<a
							class="category-card"
							href={`/shop?category=${encodeURIComponent(category.name)}`}
						>
						<img src={category.image} alt="" loading="lazy" />
						<div class="category-shade"></div>
						<div class="category-info">
							<div><span>{category.description}</span><h3>{category.name}</h3></div>
							<span class="circle-arrow" aria-hidden="true">↗</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="section products-section" id="products">
			<div class="section-heading product-heading">
				<div>
					<p class="eyebrow">The good things</p>
					<h2>Made for <em>every day.</em></h2>
				</div>
				<p class="section-aside">Keep the things that make your everyday feel a little more special.</p>
			</div>
			<div class="filter-row">
				<div class="filter-buttons" role="group" aria-label="Filter products by category">
					<button class="filter-button active" type="button" data-filter="All" aria-pressed="true">All pieces</button>
					{categories.map((category) => (
						<button class="filter-button" type="button" data-filter={category.name} aria-pressed="false">
							{category.name}
						</button>
					))}
				</div>
				<p class="result-count" aria-live="polite"><span id="product-count">{products.length}</span> considered pieces</p>
			</div>
			<div class="product-grid" id="product-grid">
				{products.map((product) => <ProductCard product={product} />)}
				<p class="empty-state" id="empty-state" hidden>No pieces found. Try another search or category.</p>
			</div>
		</section>

		<section class="story-section" id="about">
			<div class="story-image">
				<img
					src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=1400&q=85"
					alt="Natural materials and warm, simple details in a thoughtfully designed home"
					loading="lazy"
				/>
				<span class="image-caption">A home is never finished. It grows with you.</span>
			</div>
			<div class="story-copy">
				<p class="eyebrow">A little about us</p>
				<h2>Less, but with<br />more <em>meaning.</em></h2>
				<p>
					FORMA began with a simple thought: the things we live with should make life feel better.
					Not louder, not busier—just a little more considered.
				</p>
				<p>
					We work with independent makers and responsible workshops to create honest, useful pieces
					that feel at home wherever you are.
				</p>
				<a class="text-link story-link" href="#promise">The way we do things <span aria-hidden="true">↗</span></a>
				<div class="story-signoff">Good things take thought. <span>— The FORMA team</span></div>
			</div>
		</section>

		<section class="section promise-section" id="promise">
			<div class="section-heading">
				<div><p class="eyebrow">The FORMA feeling</p><h2>Good by <em>nature.</em></h2></div>
				<p class="section-aside">Beautiful things should feel good in every way.</p>
			</div>
			<div class="promise-grid">
				<article class="promise-item">
					<span class="promise-number">01</span>
					<svg viewBox="0 0 44 44" aria-hidden="true"><path d="M22 5c7 9 13 14 13 21a13 13 0 0 1-26 0C9 19 15 14 22 5Z" /><path d="M16 28c1 3 3 4 6 5" /></svg>
					<h3>Thoughtful design</h3><p>Useful, beautiful objects designed with a little more care.</p>
				</article>
				<article class="promise-item">
					<span class="promise-number">02</span>
					<svg viewBox="0 0 44 44" aria-hidden="true"><path d="M22 6 36 14v16L22 38 8 30V14L22 6Z" /><path d="m8 14 14 8 14-8M22 22v16" /></svg>
					<h3>Made to last</h3><p>Good materials, considered details, and quality you can feel.</p>
				</article>
				<article class="promise-item">
					<span class="promise-number">03</span>
					<svg viewBox="0 0 44 44" aria-hidden="true"><path d="M22 37s-16-9-16-20a9 9 0 0 1 16-6 9 9 0 0 1 16 6c0 11-16 20-16 20Z" /><path d="M14 22h5l3-6 4 12 3-6h2" /></svg>
					<h3>Mindful choices</h3><p>Working with people and partners who care about how things are made.</p>
				</article>
				<article class="promise-item">
					<span class="promise-number">04</span>
					<svg viewBox="0 0 44 44" aria-hidden="true"><path d="M36 17a15 15 0 1 0 1 9" /><path d="M36 7v10H26M15 22h14M22 15v14" /></svg>
					<h3>Easy by design</h3><p>Thoughtful support and easy returns, whenever you need us.</p>
				</article>
			</div>
		</section>

		<section class="newsletter-section" id="newsletter">
			<div class="newsletter-copy">
				<p class="eyebrow">A note from us</p>
				<h2>A little more <em>room to breathe.</em></h2>
				<p>New pieces, slower living, and the occasional good thing. Never too much.</p>
			</div>
			<form class="newsletter-form" id="newsletter-form">
				<label class="sr-only" for="newsletter-email">Your email address</label>
				<div class="email-field">
					<input type="email" name="email" id="newsletter-email" placeholder="Your email address" autocomplete="email" required />
					<button type="submit" aria-label="Subscribe to the newsletter">Join us <span aria-hidden="true">↗</span></button>
				</div>
				<p id="newsletter-message" aria-live="polite">This demo validates your email locally; it does not submit a subscription.</p>
			</form>
		</section>
	</main>
	<Footer />

	<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
	<aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true">
		<div class="drawer-header">
			<div><p class="eyebrow">Your considered finds</p><h2 id="cart-title">Your bag <span id="drawer-count">(0)</span></h2></div>
			<button class="icon-button drawer-close" type="button" aria-label="Close shopping bag">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
			</button>
		</div>
		<div class="cart-items" id="cart-items"></div>
		<div class="cart-empty" id="cart-empty">
			<span class="empty-bag-icon" aria-hidden="true">○</span>
			<h3>Your bag is taking a breather.</h3>
			<p>Find something lovely to bring home.</p>
			<button class="button button-dark continue-shopping" type="button">Explore the collection</button>
		</div>
		<div class="cart-summary" id="cart-summary" hidden>
			<p><span>Subtotal</span><strong id="cart-subtotal">₹0</strong></p>
			<small>Shipping and taxes calculated at checkout.</small>
			<a class="button button-dark checkout-button" href="/checkout">Proceed to checkout <span aria-hidden="true">↗</span></a>
			<button class="continue-link continue-shopping" type="button">Keep looking</button>
		</div>
	</aside>
</Layout>

<script>
	import { products, formatPrice } from '../data/products.js';
	import { addToCart, getCart, saveCart } from '../data/cart.js';
	const cartDrawer = document.querySelector('#cart-drawer');
	const backdrop = document.querySelector('#drawer-backdrop');
	const cartItems = document.querySelector('#cart-items');
	const cartEmpty = document.querySelector('#cart-empty');
	const cartSummary = document.querySelector('#cart-summary');
	const cartCount = document.querySelector('#cart-count');
	const cartSubtotal = document.querySelector('#cart-subtotal');
	const drawerCount = document.querySelector('#drawer-count');
	const countLabel = document.querySelector('#product-count');
	const productCards = [...document.querySelectorAll('[data-product]')];
	const searchInput = document.querySelector('#site-search');
	const searchPanel = document.querySelector('#search-panel');
	let activeFilter = 'All';
	let cart = getCart();
	let lastFocusedElement;

	function renderCart() {
		const quantity = cart.reduce((total, item) => total + item.quantity, 0);
		const subtotal = cart.reduce((total, item) => total + products.find((product) => product.id === item.id).price * item.quantity, 0);
		cartCount.textContent = quantity;
		cartCount.hidden = quantity === 0;
		drawerCount.textContent = `(${quantity})`;
		cartEmpty.hidden = cart.length > 0;
		cartSummary.hidden = cart.length === 0;
		cartItems.replaceChildren();
		cart.forEach((item) => {
			const product = products.find((entry) => entry.id === item.id);
			const row = document.createElement('article');
			row.className = 'cart-item';
			row.innerHTML = `
				<img src="${product.image}" alt="" />
				<div class="cart-item-details">
					<div class="cart-item-top"><div><h3>${product.name}</h3><p>${product.category}</p></div><strong>${formatPrice(product.price * item.quantity)}</strong></div>
					<div class="cart-item-bottom"><div class="quantity-control"><button type="button" data-quantity="${product.id}" data-change="-1" aria-label="Remove one ${product.name}">−</button><span>${item.quantity}</span><button type="button" data-quantity="${product.id}" data-change="1" aria-label="Add one ${product.name}">+</button></div><button class="remove-item" type="button" data-remove="${product.id}">Remove</button></div>
				</div>`;
			cartItems.append(row);
		});
		cartSubtotal.textContent = formatPrice(subtotal);
		saveCart(cart);
	}

	function setDrawerOpen(open) {
		cartDrawer.classList.toggle('is-open', open);
		cartDrawer.setAttribute('aria-hidden', String(!open));
		backdrop.hidden = !open;
		document.body.classList.toggle('drawer-open', open);
		if (open) {
			lastFocusedElement = document.activeElement;
			cartDrawer.querySelector('.drawer-close').focus();
		} else if (lastFocusedElement instanceof HTMLElement) {
			lastFocusedElement.focus();
		}
	}

	function filterProducts() {
		const term = searchInput.value.trim().toLowerCase();
		let visibleCount = 0;
		productCards.forEach((card) => {
			const matchesCategory = activeFilter === 'All' || card.dataset.category === activeFilter;
			const matchesSearch = !term || card.dataset.name.includes(term) || card.dataset.category.toLowerCase().includes(term);
			const visible = matchesCategory && matchesSearch;
			card.hidden = !visible;
			if (visible) visibleCount += 1;
		});
		countLabel.textContent = visibleCount;
		document.querySelector('#empty-state').hidden = visibleCount !== 0;
	}

	document.querySelectorAll('[data-filter]').forEach((button) => {
		button.addEventListener('click', () => {
			activeFilter = button.dataset.filter;
			document.querySelectorAll('[data-filter]').forEach((option) => {
				const selected = option === button;
				option.classList.toggle('active', selected);
				option.setAttribute('aria-pressed', String(selected));
			});
			filterProducts();
		});
	});

	document.querySelectorAll('[data-add]').forEach((button) => {
		button.addEventListener('click', () => {
			cart = addToCart(button.dataset.add);
			renderCart();
			setDrawerOpen(true);
		});
	});

	cartItems.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		if (target.dataset.remove) {
			cart = cart.filter((item) => item.id !== target.dataset.remove);
		} else if (target.dataset.quantity) {
			const item = cart.find((entry) => entry.id === target.dataset.quantity);
			item.quantity += Number(target.dataset.change);
			if (item.quantity <= 0) cart = cart.filter((entry) => entry !== item);
		}
		renderCart();
	});

	document.querySelectorAll('.cart-trigger').forEach((button) => button.addEventListener('click', () => setDrawerOpen(true)));
	document.querySelector('.drawer-close').addEventListener('click', () => setDrawerOpen(false));
	backdrop.addEventListener('click', () => setDrawerOpen(false));
	document.querySelectorAll('.continue-shopping').forEach((button) => button.addEventListener('click', () => setDrawerOpen(false)));
	document.addEventListener('keydown', (event) => {
		if (!cartDrawer.classList.contains('is-open')) return;
		if (event.key === 'Escape') {
			setDrawerOpen(false);
			return;
		}
		if (event.key !== 'Tab') return;

		const focusableElements = [...cartDrawer.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')]
			.filter((element) => element.getClientRects().length > 0);
		const firstElement = focusableElements[0];
		const lastElement = focusableElements[focusableElements.length - 1];
		if (event.shiftKey && document.activeElement === firstElement) {
			event.preventDefault();
			lastElement.focus();
		} else if (!event.shiftKey && document.activeElement === lastElement) {
			event.preventDefault();
			firstElement.focus();
		}
	});

	searchInput.addEventListener('input', () => {
		filterProducts();
		searchPanel.hidden = searchInput.value.trim().length === 0;
	});
	document.querySelector('#newsletter-form').addEventListener('submit', (event) => {
		event.preventDefault();
		const form = event.currentTarget;
		const email = new FormData(form).get('email');
		const message = document.querySelector('#newsletter-message');
		if (!form.reportValidity()) return;
		message.textContent = `Email format validated for ${email}. This demo does not submit subscriptions.`;
		message.classList.add('success-message');
		form.reset();
	});

	renderCart();
</script>

<style>
	:global(:root) {
		--paper: #f7f5f0;
		--cream: #eeece5;
		--ink: #272722;
		--muted: #77766f;
		--line: #dfddd5;
		--olive: #6d7158;
		--serif: 'Cormorant Garamond', Georgia, serif;
		--sans: 'DM Sans', Arial, sans-serif;
	}
	:global(body) { background: var(--paper); color: var(--ink); font-family: var(--sans); }
	:global(a) { color: inherit; }
	:global(button), :global(input) { font: inherit; }
	:global(button:focus-visible), :global(a:focus-visible), :global(input:focus-visible) { outline: 2px solid var(--olive); outline-offset: 4px; }
	:global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
	.hero { min-height: 610px; display: grid; grid-template-columns: 41% 59%; padding: 38px 5.2vw 0; overflow: hidden; }
	.hero-copy { padding: clamp(62px, 8vw, 124px) 25px 42px 2vw; position: relative; z-index: 1; isolation: isolate; }
	.hero-copy::before { position: absolute; z-index: -1; content: ''; inset: -10% -12% -12% -15%; pointer-events: none; background: radial-gradient(ellipse at 28% 42%, #b8c19a 0, transparent 39%), radial-gradient(ellipse at 68% 28%, #e2b79c 0, transparent 37%), radial-gradient(ellipse at 56% 78%, #d7c09d 0, transparent 43%); background-size: 150% 150%; filter: blur(14px); opacity: .9; animation: ambient-flow 9s ease-in-out infinite alternate; }
	.hero-copy::after { position: absolute; z-index: -1; content: ''; width: clamp(280px, 38vw, 510px); aspect-ratio: 1; left: 18%; top: 50%; border: 1px solid #6d71584a; border-radius: 50%; pointer-events: none; background: repeating-radial-gradient(circle, transparent 0 45px, #6d71582a 46px 47px, transparent 48px 83px); mask-image: radial-gradient(circle, #000 35%, transparent 72%); animation: orbital-drift 24s linear infinite; }
	.hero-copy > * { position: relative; z-index: 1; }
	@keyframes ambient-flow { 0% { transform: translate3d(-3%, 2%, 0) scale(.91) rotate(-4deg); background-position: 0% 50%; } 50% { transform: translate3d(4%, -3%, 0) scale(1.1) rotate(3deg); background-position: 100% 20%; } 100% { transform: translate3d(-1%, 3%, 0) scale(1.02) rotate(-2deg); background-position: 40% 100%; } }
	@keyframes orbital-drift { to { transform: translateY(-50%) rotate(360deg); } }
	.eyebrow { margin: 0 0 22px; color: var(--olive); font-size: 10px; text-transform: uppercase; letter-spacing: .19em; font-weight: 600; }
	.hero .eyebrow { display: flex; align-items: center; gap: 10px; }
	.hero .eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #89906d; }
	h1, h2, h3, p { margin-top: 0; }
	.hero h1 { font-size: clamp(56px, 6vw, 86px); line-height: .96; letter-spacing: -.055em; font-weight: 400; margin: 0 0 24px; }
	h1 em, h2 em { font-family: var(--serif); font-weight: 400; }
	.hero-description { max-width: 350px; color: var(--muted); font-size: 13px; line-height: 1.9; margin-bottom: 28px; }
	.button { border: 0; display: inline-flex; align-items: center; gap: 26px; padding: 15px 19px; text-decoration: none; font-size: 10px; letter-spacing: .04em; cursor: pointer; transition: background .25s ease, transform .25s ease; }
	.button:hover { transform: translateY(-2px); }
	.button-dark { background: var(--ink); color: white; }
	.button-dark:hover { background: var(--olive); }
	.button svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.3; }
	.hero-note { display: flex; gap: 12px; align-items: center; color: var(--muted); font-family: var(--serif); font-size: 15px; font-style: italic; margin-top: 36px; }
	.note-rule { width: 35px; height: 1px; background: #b7b4a8; }
	.hero-visual { position: relative; min-height: 515px; overflow: hidden; background: #ded8ce; }
	.hero-visual > img, .story-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
	.hero-visual > img { position: absolute; inset: 0; object-position: center 54%; animation: hero-image-in 1.5s cubic-bezier(.2,.7,.2,1) both; }
	.hero-visual::after { position: absolute; inset: 0; content: ''; pointer-events: none; background: linear-gradient(112deg, transparent 20%, #fff5 48%, transparent 70%); transform: translateX(-120%) skewX(-12deg); animation: image-glint 7s ease-in-out 1s infinite; }
	@keyframes image-glint { 0%, 48% { transform: translateX(-120%) skewX(-12deg); } 75%, 100% { transform: translateX(120%) skewX(-12deg); } }
	@keyframes hero-image-in { from { opacity: .7; transform: scale(1.08); } to { opacity: 1; transform: scale(1); } }
	.hero-image-label { position: absolute; left: 22px; right: 22px; bottom: 18px; color: white; display: flex; justify-content: space-between; font-size: 9px; letter-spacing: .09em; text-transform: uppercase; text-shadow: 0 1px 5px #3338; }
	.hero-stamp { position: absolute; right: 24px; top: 24px; width: 111px; height: 111px; border: 1px solid #fff9; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; color: white; text-align: center; text-shadow: 0 1px 6px #3338; transform: rotate(8deg); animation: stamp-float 7s ease-in-out infinite; }
	@keyframes stamp-float { 50% { transform: translateY(-8px) rotate(2deg); } }
	.hero-stamp span { font-size: 6px; letter-spacing: .15em; }
	.hero-stamp strong { font-family: var(--serif); font-weight: 400; font-size: 19px; line-height: 1.2; margin: 4px 0; }
	.trust-strip { min-height: 78px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: center; gap: clamp(20px, 4vw, 62px); padding: 15px 5vw; }
	.trust-strip p { margin: 0; font-family: var(--serif); font-size: 16px; }
	.trust-strip > span { width: 3px; height: 3px; border-radius: 50%; background: #9a998f; }
	.section { padding: 105px 8.3vw; }
	.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 28px; margin-bottom: 34px; }
	.section-heading .eyebrow { margin-bottom: 13px; }
	.section-heading h2, .story-copy h2, .newsletter-copy h2 { font-size: clamp(38px, 4vw, 56px); letter-spacing: -.045em; line-height: 1; font-weight: 400; margin: 0; }
	.text-link { display: inline-flex; gap: 15px; align-items: center; color: var(--ink); font-size: 10px; text-decoration: none; padding-bottom: 6px; border-bottom: 1px solid #bcbab2; transition: gap .3s cubic-bezier(.2,.7,.2,1), border-color .2s; }
	.text-link:hover { gap: 22px; border-color: var(--ink); }
	.category-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; }
