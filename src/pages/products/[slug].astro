---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, formatPrice } from '../../data/products.js';

export function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const relatedProducts = products.filter((item) => item.id !== product.id).slice(0, 4);
---

<Layout
	title={`${product.name} — FORMA`}
	description={product.description}
	socialImage={product.image}
	socialImageAlt={product.name}
>
	<Header />
	<main>
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">Home</a><span aria-hidden="true">/</span><a href="/shop">Shop</a><span aria-hidden="true">/</span><span>{product.name}</span>
		</nav>
		<section class="product-detail">
			<div class="detail-image">
				<img src={product.image} alt={product.name} fetchpriority="high" />
				{product.tag && <span class="product-tag">{product.tag}</span>}
			</div>
			<div class="detail-copy">
				<p class="eyebrow">{product.category}</p>
				<h1>{product.name}</h1>
				<p class="price">{formatPrice(product.price)}</p>
				<p class="description">{product.description}</p>
				<div class="detail-rule"></div>
				<p class="detail-label">Material</p>
				<p class="material">{product.material}</p>
				<button class="add-button" type="button" data-add={product.id}>
					<span>Add to bag</span><span>{formatPrice(product.price)}</span>
				</button>
				<p class="add-feedback" id="add-feedback" role="status" aria-live="polite"></p>
				<p class="shipping-note">Thoughtfully packed. Free shipping on orders above ₹1,999.</p>
				<a class="back-link" href="/shop">← Back to the collection</a>
			</div>
		</section>
		<section class="related-section">
			<div class="related-heading"><p class="eyebrow">A few more good things</p><h2>Consider these, too.</h2></div>
			<div class="related-grid">
				{relatedProducts.map((item) => <ProductCard product={item} />)}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { addToCart } from '../../data/cart.js';

	document.querySelectorAll('[data-add]').forEach((button) => {
		button.addEventListener('click', () => {
			addToCart(button.dataset.add);
			document.querySelector('#add-feedback').textContent = 'Added to your bag.';
			button.querySelector('span').textContent = 'Added to bag';
			window.setTimeout(() => (button.querySelector('span').textContent = 'Add to bag'), 1200);
		});
	});
</script>

<style>
	:global(body) { background: #f7f5f0; color: #272722; font-family: 'DM Sans', Arial, sans-serif; }
	:global(button:focus-visible), :global(a:focus-visible) { outline: 2px solid #6d7158; outline-offset: 4px; }
	.breadcrumbs { display: flex; gap: 10px; align-items: center; padding: 24px 8vw 15px; color: #77766f; font-size: 9px; }
	.breadcrumbs a { color: inherit; text-decoration: none; }
	.breadcrumbs a:hover { color: #272722; }
	.product-detail { display: grid; grid-template-columns: 1.08fr .92fr; gap: clamp(45px, 8vw, 115px); padding: 15px 11vw 75px; align-items: center; }
	.detail-image { position: relative; background: #e2dfd8; }
	.detail-image img { display: block; width: 100%; max-height: 690px; aspect-ratio: .88; object-fit: cover; }
	.product-tag { position: absolute; top: 15px; left: 15px; background: #f7f5f0ed; color: #272722; padding: 7px 10px; text-transform: uppercase; letter-spacing: .1em; font-size: 7px; }
	.detail-copy { padding: 20px 0; max-width: 420px; }
	.eyebrow { margin: 0 0 15px; color: #6d7158; font-size: 9px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; }
	.detail-copy h1 { margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(39px, 4vw, 55px); font-weight: 400; line-height: 1.04; letter-spacing: -.035em; }
	.price { margin: 15px 0 24px; font-size: 13px; }
	.description { color: #77766f; font-size: 11px; line-height: 1.9; max-width: 360px; margin: 0; }
	.detail-rule { height: 1px; background: #dfddd5; margin: 25px 0 20px; }
	.detail-label { color: #77766f; font-size: 8px; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 7px; }
	.material { font-size: 10px; margin: 0 0 27px; }
	.add-button { display: flex; width: 100%; justify-content: space-between; align-items: center; padding: 16px 18px; border: 0; background: #272722; color: white; cursor: pointer; font-size: 10px; transition: background .2s; }
	.add-button:hover { background: #6d7158; }
	.add-feedback { min-height: 15px; color: #6d7158; font-size: 9px; margin: 9px 0 0; }
	.shipping-note { color: #77766f; font-size: 8px; margin: 5px 0 25px; }
	.back-link { color: #54544d; font-size: 9px; text-decoration: none; border-bottom: 1px solid #c9c7bd; padding-bottom: 5px; }
	.related-section { padding: 55px 8.3vw 95px; background: #efede7; }
	.related-heading { margin-bottom: 26px; }
	.related-heading .eyebrow { margin-bottom: 9px; }
	.related-heading h2 { margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 34px; font-weight: 400; }
	.related-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; }
	@media(max-width: 980px) {
		.product-detail { padding-inline: 7vw; gap: 6vw; }
		.related-section { padding-inline: 6vw; }
		.related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.related-grid :global(.product-card:last-child) { display: none; }
	}
	@media(max-width: 680px) {
		.breadcrumbs { padding: 19px 6vw 12px; flex-wrap: wrap; font-size: 8px; }
		.product-detail { grid-template-columns: 1fr; padding: 8px 6vw 50px; gap: 26px; }
		.detail-image img { max-height: none; aspect-ratio: .92; }
		.detail-copy { padding: 0 2px; }
		.detail-copy h1 { font-size: 41px; }
		.price { margin: 12px 0 18px; }
		.detail-rule { margin: 20px 0 17px; }
		.related-section { padding: 43px 6vw 65px; }
		.related-heading h2 { font-size: 29px; }
		.related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 23px 10px; }
		.related-grid :global(.product-card:last-child) { display: block; }
	}
</style>
