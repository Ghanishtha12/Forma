---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products.js';

const categories = [...new Set(products.map((product) => product.category))];
---

<Layout
	title="Shop Home & Lifestyle Essentials — FORMA"
	description="Shop considered furniture, home decor, lighting and everyday essentials, thoughtfully made for a life well lived."
>
	<Header />
	<main>
		<section class="shop-intro">
			<p class="eyebrow">The FORMA collection</p>
			<h1>Good things for<br />the <em>every day.</em></h1>
			<p>Thoughtful pieces for the spaces and small rituals that make a place feel like yours.</p>
		</section>
		<section class="shop-catalog" id="products" aria-labelledby="shop-title">
			<div class="catalog-heading">
				<div><p class="eyebrow">Considered, always</p><h2 id="shop-title">Shop all pieces</h2></div>
				<label class="catalog-search">
					<span class="sr-only">Search products</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 4.5 4.5"></path></svg>
					<input type="search" id="shop-search" placeholder="Search the collection" />
				</label>
			</div>
			<div class="catalog-tools">
				<div class="filter-buttons" role="group" aria-label="Filter products by category">
					<button type="button" class="filter-button active" data-filter="All" aria-pressed="true">All pieces</button>
					{categories.map((category) => (
						<button type="button" class="filter-button" data-filter={category} aria-pressed="false">{category}</button>
					))}
				</div>
				<p class="result-count" aria-live="polite"><span id="product-count">{products.length}</span> pieces</p>
			</div>
			<div class="product-grid">
				{products.map((product) => (
					<div class="product-entry" data-product-entry data-category={product.category} data-name={product.name.toLowerCase()}>
						<ProductCard product={product} />
					</div>
				))}
				<p class="empty-state" id="empty-state" hidden>No pieces found. Try another search or category.</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	import { addToCart } from '../data/cart.js';

	const search = document.querySelector('#shop-search');
	const entries = [...document.querySelectorAll('[data-product-entry]')];
	const count = document.querySelector('#product-count');
	const emptyState = document.querySelector('#empty-state');
	let activeCategory = 'All';

	function filterProducts() {
		const term = search.value.trim().toLowerCase();
		let visibleCount = 0;
		entries.forEach((entry) => {
			const matchesCategory = activeCategory === 'All' || entry.dataset.category === activeCategory;
			const matchesSearch =
				!term || entry.dataset.name.includes(term) || entry.dataset.category.toLowerCase().includes(term);
			entry.hidden = !(matchesCategory && matchesSearch);
			if (!entry.hidden) visibleCount += 1;
		});
		count.textContent = visibleCount;
		emptyState.hidden = visibleCount > 0;
	}

	search.addEventListener('input', filterProducts);
	document.querySelectorAll('[data-filter]').forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.filter;
			document.querySelectorAll('[data-filter]').forEach((option) => {
				const active = option === button;
				option.classList.toggle('active', active);
				option.setAttribute('aria-pressed', String(active));
			});
			filterProducts();
		});
	});

	const params = new URLSearchParams(window.location.search);
	search.value = params.get('search') || '';
	const requestedCategory = params.get('category');
	if (requestedCategory) {
		const categoryButton = [...document.querySelectorAll('[data-filter]')].find(
			(button) => button.dataset.filter === requestedCategory,
		);
		categoryButton?.click();
	}
	filterProducts();

	document.querySelectorAll('[data-add]').forEach((button) => {
		button.addEventListener('click', () => {
			addToCart(button.dataset.add);
			button.querySelector('span').textContent = 'Added to bag';
			window.setTimeout(() => (button.querySelector('span').textContent = 'Add to bag'), 1200);
		});
	});
</script>

<style>
	:global(body) { background: #f7f5f0; color: #272722; font-family: 'DM Sans', Arial, sans-serif; }
	:global(button:focus-visible), :global(input:focus-visible), :global(a:focus-visible) { outline: 2px solid #6d7158; outline-offset: 4px; }
	:global(.sr-only) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
	.shop-intro { padding: 79px 9vw 66px; text-align: center; background: #efede7; }
	.eyebrow { margin: 0 0 17px; color: #6d7158; font-size: 9px; font-weight: 600; letter-spacing: .19em; text-transform: uppercase; }
	h1, h2 { font-weight: 400; }
	.shop-intro h1 { font-size: clamp(52px, 6vw, 78px); line-height: .96; letter-spacing: -.05em; margin: 0; }
	.shop-intro h1 em { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400; }
	.shop-intro > p:last-child { color: #77766f; max-width: 430px; margin: 21px auto 0; font-size: 11px; line-height: 1.8; }
	.shop-catalog { padding: 70px 8.3vw 100px; }
	.catalog-heading { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin-bottom: 30px; }
	.catalog-heading .eyebrow { margin-bottom: 10px; }
	.catalog-heading h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 34px; margin: 0; }
	.catalog-search { display: flex; align-items: center; gap: 10px; width: min(250px, 40%); border-bottom: 1px solid #c9c7bd; }
	.catalog-search svg { width: 16px; height: 16px; fill: none; stroke: #55554e; stroke-width: 1.3; }
	.catalog-search input { width: 100%; padding: 11px 0; border: 0; outline: 0; background: transparent; color: #272722; font-size: 10px; }
	.catalog-search input::placeholder { color: #929087; }
	.catalog-tools { display: flex; justify-content: space-between; align-items: center; gap: 20px; border-bottom: 1px solid #dfddd5; margin-bottom: 25px; }
	.filter-buttons { display: flex; gap: 22px; overflow-x: auto; }
	.filter-button { flex: 0 0 auto; border: 0; padding: 10px 0 13px; background: transparent; color: #77766f; cursor: pointer; font-size: 10px; border-bottom: 1px solid transparent; }
	.filter-button:hover, .filter-button.active { color: #272722; border-color: #272722; }
	.result-count { flex: 0 0 auto; color: #77766f; font-size: 9px; margin: 0 0 3px; }
	.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 35px 17px; }
	.product-entry[hidden] { display: none; }
	.empty-state { grid-column: 1 / -1; padding: 50px 0; color: #77766f; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; text-align: center; }
	@media(max-width: 980px) {
		.shop-catalog { padding-inline: 6vw; }
		.product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media(max-width: 680px) {
		.shop-intro { padding: 61px 7vw 51px; }
		.shop-intro h1 { font-size: clamp(53px, 13vw, 70px); }
		.shop-catalog { padding: 50px 6vw 72px; }
		.catalog-heading { align-items: stretch; flex-direction: column; gap: 20px; margin-bottom: 23px; }
		.catalog-heading h2 { font-size: 30px; }
		.catalog-search { width: 100%; }
		.catalog-tools { align-items: flex-start; flex-direction: column; gap: 8px; padding-bottom: 10px; }
		.filter-buttons { width: 100%; gap: 17px; }
		.filter-button { font-size: 9px; }
		.result-count { margin: 0; }
		.product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 10px; }
	}
</style>
